{
  "name": "remack",
  "version": "0.4.0",
  "description": "Zero-dependency, Remix-shaped Slack framework with a twilio-style CLI: web-standard Request/Response core, file-based route modules, error boundaries, pluggable KV storage, and scaffold/manifest/profiles/dev commands \u2014 no database required.",
  "type": "module",
  "bin": {
    "remack": "bin/remack.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./node": "./lib/node.js",
    "./helpers": "./lib/helpers.js",
    "./workflow": "./lib/workflow.js",
    "./ext/*": "./ext/*.js"
  },
  "files": [
    "bin",
    "lib",
    "ext",
    "dist",
    "migrations",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robjshaw/remack.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test",
    "example": "node examples/route-bot/app.js",
    "build:apps-script": "node bin/remack.js build:apps-script --out dist/apps-script/remack.js"
  }
}
